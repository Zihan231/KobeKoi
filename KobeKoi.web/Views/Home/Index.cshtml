@model List<KobeKoi.BLL.DTO.EventDTO>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">Upcoming Events</h2>

    <!-- Search + Filter -->
    <div class="row mb-4">

        <div class="col-md-7 mb-2">
            <input type="text"
                   class="form-control"
                   placeholder="Search event by title..." />
        </div>
        <div class="col-md-2 mb-2">
            <button class="btn btn-dark w-100">
                Search
            </button>
        </div>

        <div class="col-md-3 mb-2">
            <select class="form-select">
                <option selected disabled>Filter</option>
                <option>Highest Price</option>
                <option>Lowest Price</option>
                <option>Newest</option>
                <option>Today</option>
            </select>
        </div>

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center mt-5">
            <h4 class="text-muted">No events available</h4>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4>@item.Title</h4>

                            <hr />

                            <p class="mb-3">
                                <b>Date:</b> @item.EventDate.ToString("dd MMM yyyy") <br />
                                <b>Ticket Price:</b> @item.TicketPrice ৳ <br />
                                <b>Available Seats:</b> @item.AvailableSeats <br />
                                <b>Max Capacity:</b> @item.MaxCapacity <br />
                                <b>Venue:</b> @item.VenueName <br />
                                <b>Address:</b> @item.VenueAddress
                            </p>

                            <a asp-controller="Event"
                               asp-action="Book"
                               asp-route-id="@item.Id"
                               class="btn btn-dark btn-sm">
                                Book Now
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>