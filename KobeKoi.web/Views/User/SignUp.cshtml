@model KobeKoi.BLL.DTO.CreateUserDTO

@{
    ViewData["Title"] = "Sign Up";
}

<div class="container d-flex justify-content-center align-items-center">

    <div class="card shadow-sm p-4" style="width: 400px; border-radius: 10px;">

        <h3 class="text-center mb-4">Create Account</h3>

        <form asp-action="SignUp" asp-controller="Auth" method="post">

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter your name" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="1">User</option>
                    <option value="2">Organizer</option>
                    <option value="3">Admin</option>
                </select>
            </div>

            <div class="d-grid gap-2">

                <button type="submit" class="btn btn-dark">
                    Sign Up
                </button>

                <a asp-action="Login" asp-controller="User" class="btn btn-outline-secondary">
                    Login
                </a>

            </div>

        </form>

    </div>

</div>